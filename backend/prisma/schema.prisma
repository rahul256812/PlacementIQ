generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  RECRUITER
  ADMIN
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  OFFERED
  ACCEPTED
  DECLINED
}

enum RecruiterStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  role           Role     @default(STUDENT)
  fullName       String
  createdAt      DateTime @default(now())

  studentProfile   StudentProfile?
  recruiterProfile RecruiterProfile?
}

model StudentProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  college         String?
  branch          String?
  graduationYear  Int?
  skills          String?
  cgpa            Float?
  experience      String?
  projects        String?
  
  user            User     @relation(fields: [userId], references: [id])
  applications    Application[]
}

model RecruiterProfile {
  id              String          @id @default(uuid())
  userId          String          @unique
  companyName     String
  designation     String
  status          RecruiterStatus @default(PENDING)

  user            User            @relation(fields: [userId], references: [id])
  jobs            Job[]
}

model Job {
  id                 String   @id @default(uuid())
  recruiterProfileId String
  title              String
  description        String
  requirements       String
  salaryRange        String?
  jobType            String?
  location           String?
  isOpen             Boolean  @default(true)
  questions          Json?
  createdAt          DateTime @default(now())

  recruiter          RecruiterProfile @relation(fields: [recruiterProfileId], references: [id])
  applications       Application[]
  rounds             InterviewRound[]
  roundMessages      RoundMessage[]
}

model Application {
  id               String            @id @default(uuid())
  jobId            String
  studentProfileId String
  status           ApplicationStatus @default(APPLIED)
  coverLetterText  String            
  answers          Json?
  appliedAt        DateTime          @default(now())

  job              Job               @relation(fields: [jobId], references: [id])
  student          StudentProfile    @relation(fields: [studentProfileId], references: [id])
  progressions     CandidateProgress[]
}

model InterviewRound {
  id           String              @id @default(uuid())
  jobId        String
  title        String
  type         String              // MCQ, CODING, TECHNICAL_INTERVIEW, HR_INTERVIEW, GROUP_DISCUSSION, CUSTOM
  format       String              // ONLINE, IN_PERSON
  description  String?
  instructions String?
  order        Int                 // 0-indexed sorting
  createdAt    DateTime            @default(now())

  job          Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  progressions CandidateProgress[]
  messages     RoundMessage[]
}

model CandidateProgress {
  id            String         @id @default(uuid())
  applicationId String
  roundId       String
  status        String         @default("PENDING") // PENDING, QUALIFIED, REJECTED
  feedback      String?
  updatedAt     DateTime       @updatedAt

  application   Application    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  round         InterviewRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([applicationId, roundId])
}

model RoundMessage {
  id         String          @id @default(uuid())
  jobId      String
  roundId    String?         // Null means general announcement for all applicants
  senderId   String
  senderName String
  content    String
  createdAt  DateTime        @default(now())

  job        Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  round      InterviewRound? @relation(fields: [roundId], references: [id], onDelete: Cascade)
}
