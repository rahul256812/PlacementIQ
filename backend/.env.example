# ─── Database ───────────────────────────────────────────────
# Get this from Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ─── Auth ────────────────────────────────────────────────────
# Generate a strong random string (e.g. openssl rand -base64 32)
JWT_SECRET="replace_with_a_very_strong_random_secret"

# ─── Server ──────────────────────────────────────────────────
PORT=3000

# ─── CORS ────────────────────────────────────────────────────
# Your Vercel frontend URL (no trailing slash)
# e.g. https://placement-iq.vercel.app
FRONTEND_URL="https://your-app.vercel.app"
